#: ../Bruskel.Tools/Tools/MoveSelectedTool.cs:49
#, csharp-format
msgid ""
"Left click and drag the selection to move selected content.\n"
"Hold {0} to scale instead of move.\n"
"Right click and drag the selection to rotate selected content.\n"
"Hold Shift to rotate in steps.\n"
"Use arrow keys to move selected content by a single pixel."
msgstr ""
"Click sinistro e trascina la selezione per spostare il contenuto "
"selezionato.\n"
"Tieni premuto {0} per ridimensionare invece di muovere.\n"
"Click destro e trascina la selezione per ruotare il contenuto selezionato.\n"
"Tieni premuto Shift per ruotare gradualmente.\n"
"Utilizza i tasti freccia per spostare il contenuto selezionato di un singolo "
"pixel."

#: ../Bruskel.Tools/Tools/MoveSelectionTool.cs:50
#, csharp-format
msgid ""
"Left click and drag the selection to move selection outline.\n"
"Hold {0} to scale instead of move.\n"
"Right click and drag the selection to rotate selection outline.\n"
"Hold Shift to rotate in steps.\n"
"Use arrow keys to move selection outline by a single pixel."
msgstr ""
"Click sinistro e trascina la selezione per spostare il bordo selezionato.\n"
"Tieni premuto {0} per ridimensionare invece di muovere.\n"
"Click destro e trascina la selezione per ruotare il bordo selezionato.\n"
"Tieni premuto Shift per ruotare gradualmente.\n"
"Utilizza i tasti freccia per spostare il bordo selezionato di un singolo "
"pixel."

#. Translators: {0} is 'Ctrl', or a platform-specific key such as 'Command' on macOS.
#: ../Bruskel.Tools/Tools/ShapeTool.cs:50
#, csharp-format
msgid ""
"Left click to draw a shape with the primary color.\n"
"Left click on a shape to add a control point.\n"
"Left click on a control point and drag to move it.\n"
"Right click on a control point and drag to change its tension.\n"
"Hold Shift to snap to angles.\n"
"Use arrow keys to move the selected control point.\n"
"Press {0} + left/right arrows to select control points by order.\n"
"Press Delete to delete the selected control point.\n"
"Press Space to add a new control point at the mouse position.\n"
"Hold {0} while pressing Space to create the control point at the exact same "
"position.\n"
"Hold {0} while left clicking on a control point to create a new shape at the "
"exact same position.\n"
"Press Enter to finalize the shape."
msgstr ""
"Click sinistro per disegnare una forma con il colore primario.\n"
"Click sinistro su una forma per aggiungere un punto di controllo.\n"
"Click sinistro su un punto di controllo e trascina per spostarlo.\n"
"Click destro su un punto di controllo e trascina per modificarne la "
"tensione.\n"
"Tieni premuto Shift per eseguire lo snap agli angoli.\n"
"Utilizza i tasti freccia per spostare il punto di controllo selezionato.\n"
"Premi {0} + freccia sinistra/destra per selezionare i punti di controllo in "
"ordine.\n"
"Premi Delete per eliminare il punto di controllo selezionato.\n"
"Premi Spazio per aggiungere un nuovo punto di controllo nella posizione del "
"mouse.\n"
"Tieni premuto {0} mentre premi la barra spaziatrice per creare il punto di "
"controllo nella stessa identica posizione.\n"
"Tieni premuto {0} mentre fai click sinistro su un punto di controllo per "
"creare una nuova forma nella stessa identica posizione.\n"
"Premi Invio per finalizzare la forma."

#: ../Bruskel.Tools/Tools/PencilTool.cs:51
msgid ""
"Left click to draw freeform one-pixel wide lines with the primary color.\n"
"Right click to use the secondary color."
msgstr ""
"Click sinistro per disegnare linee larghe un pixel a mano libera con il "
"colore primario.\n"
"Click destro per utilizzare il colore secondario."

#: ../Bruskel.Tools/Tools/FreeformShapeTool.cs:50
